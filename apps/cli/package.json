{
  "name": "symnav",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "symnav": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "benchmark:daemon": "tsx test/benchmark/run-daemon-benchmark.ts",
    "test": "vitest run",
    "test:e2e:cold": "tsx test/e2e/run-navigation-mode.ts 0",
    "test:e2e:warm": "tsx test/e2e/run-navigation-mode.ts 1",
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "lint": "eslint src test",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@symnav/backend-typescript": "workspace:*",
    "@symnav/core": "workspace:*",
    "@symnav/renderer": "workspace:*",
    "@symnav/telemetry": "workspace:*",
    "commander": "^14.0.3",
    "fuzzysort": "^3.1.0"
  },
  "devDependencies": {
    "@symnav/testing": "workspace:*",
    "tsx": "^4.21.0"
  }
}
