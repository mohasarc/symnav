{
  "name": "symnav",
  "version": "0.4.0",
  "description": "Language-agnostic CLI for navigating codebases by symbol: definitions, references, and call paths. TypeScript supported today.",
  "keywords": [
    "cli",
    "code-navigation",
    "symbols",
    "definitions",
    "references",
    "call-graph",
    "typescript",
    "agents"
  ],
  "homepage": "https://github.com/mohasarc/symnav#readme",
  "bugs": {
    "url": "https://github.com/mohasarc/symnav/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohasarc/symnav.git",
    "directory": "apps/cli"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "symnav": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "daemon:benchmark": "tsx test/benchmark/run-daemon-benchmark.ts",
    "daemon:profile": "tsx test/benchmark/run-daemon-profile.ts",
    "test": "vitest run",
    "test:e2e:cold": "tsx test/e2e/run-navigation-mode.ts 0",
    "test:e2e:warm": "tsx test/e2e/run-navigation-mode.ts 1",
    "test:install-smoke": "vitest run --config vitest.install-smoke.config.ts",
    "build": "tsc --build && pnpm run bundle",
    "bundle": "tsx scripts/run-cli-bundle.ts",
    "typecheck": "tsc --build",
    "lint": "eslint src test scripts",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "fuzzysort": "^3.1.0",
    "ignore": "^7.0.5",
    "jsonc-parser": "^3.3.1",
    "toml-eslint-parser": "^0.10.1",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@symnav/backend-typescript": "workspace:*",
    "@symnav/core": "workspace:*",
    "@symnav/daemon": "workspace:*",
    "@symnav/renderer": "workspace:*",
    "@symnav/telemetry": "workspace:*",
    "@symnav/testing": "workspace:*",
    "esbuild": "^0.27.7",
    "tsx": "^4.21.0"
  }
}
